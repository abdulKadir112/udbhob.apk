<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02150D"
    android:padding="24dp">

    <!-- Top Badge -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvCallType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞 ইনকামিং অডিও কল"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="#10382B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="প্রবাসী মুক্ত ফান্ড • সরাসরি কল"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Caller Info (Center) -->
    <LinearLayout
        android:id="@+id/centerCallerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Avatar Container -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="#064E3B">

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="প্র"
                android:textColor="#FFFFFF"
                android:textSize="56sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Caller Name -->
        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="প্রবাসী সদস্য"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Role & Country -->
        <TextView
            android:id="@+id/tvCallerDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🇸🇦 সৌদি আরব • সদস্য"
            android:textColor="#6EE7B7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="কথা বলতে রিসিভ বাটনে প্রেস করুন"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Actions: Decline & Accept -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <!-- Decline Button -->
        <LinearLayout
            android:id="@+id/btnDecline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <Button
                android:id="@+id/btnDeclineAction"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:text="✕"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E11D48" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="কেটে দিন"
                android:textColor="#FDA4AF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Accept Button -->
        <LinearLayout
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <Button
                android:id="@+id/btnAcceptAction"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:text="📞"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#059669" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="রিসিভ করুন"
                android:textColor="#6EE7B7"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
